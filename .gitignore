# Dependencies & build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# Raw captures stay out of git (see docs/fixtures.md). Commit full-size, User-ID-masked
# PNGs (`npm run fixtures:mask`) + golden JSON instead. Only PNG is allowed in screens/, so
# an unmasked JPEG or video can't slip in.
fixtures/**/*.mp4
fixtures/**/*.mov
fixtures/**/*.jpg
fixtures/**/*.jpeg
fixtures/**/*.webp
fixtures/raw/

# Debug frames written by "save debug frames"
debug-frames/

# OS / editor
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Secrets (signing keys never live in the repo)
*.key
*.p12
*.pfx
.env
.env.*

scripts/macos-probe/target/
