{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window may call. Keep minimal: adding a permission needs an ADR (CLAUDE.md, ADR 0010/0015).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-find-game-window",
    "allow-window-candidates",
    "allow-start-capture",
    "allow-stop-capture",
    "allow-capture-status",
    "allow-capture-preview",
    "allow-ocr-region",
    "allow-auto-mode-status",
    "allow-arm-auto-mode",
    "allow-disarm-auto-mode",
    "allow-auto-focus-game",
    "allow-auto-click",
    "allow-auto-scroll",
    "allow-sample-regions",
    "allow-read-regions",
    "allow-crop-regions",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/wavescan/wavescan/*" },
        { "url": "https://wutheringwaves.kurogames.com/en/main/news/detail/742" }
      ]
    }
  ]
}
