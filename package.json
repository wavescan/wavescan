{
  "name": "wavescan",
  "private": true,
  "version": "0.0.1",
  "description": "Reads your Wuthering Waves echoes from the game window and exports them for Wuthering Tools.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "test:fixtures:tesseract": "vitest run --config vitest.fixtures.config.ts tests/tesseractReplay.fixtures.ts",
    "lint": "eslint . && vue-tsc -b",
    "check": "docker compose run --rm check",
    "data:update": "node scripts/update-scanner-data.mjs",
    "data:check": "node scripts/update-scanner-data.mjs --check",
    "icons:update": "node scripts/update-app-icon.mjs",
    "fixtures:mask": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example fixtures -- mask"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/saira-semi-condensed": "5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "@wutheringtools/scanner-core": "0.2.0",
    "tesseract.js": "7.0.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
