{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "vite.config.ts",
    "vitest.fixtures.config.ts",
    "eslint.config.js",
    "tests/**/*.ts",
    "src/**/*.spec.ts",
    "src/diagnostics/**/*.ts",
    "src/ipc/**/*.ts",
    "src/data/**/*.ts",
    "src/data/**/*.json",
    "src/session/**/*.ts",
    "src/auto/**/*.ts",
    "src/ocr/**/*.ts",
    "src/feedback/**/*.ts",
    "src/review/**/*.ts",
    "src/setup/**/*.ts",
    "src/help/**/*.ts",
    "src/ui/**/*.ts"
  ]
}
